<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        android:scrollbars="none"
        android:isScrollContainer="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/app_id_footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:maxWidth="400dp"
                android:layout_gravity="center">

                <!-- Logo Container -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/ivChorusLogo"
                        android:layout_width="180dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_chorus_logo"
                        android:layout_marginTop="50dp"
                        android:layout_marginBottom="50dp"
                        android:scaleType="fitCenter" />

                </LinearLayout>

                <!-- Welcome Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to"
                    android:textSize="32sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_marginBottom="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="32sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_marginBottom="30dp" />

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Please select your role to continue"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:alpha="0.6"
                    android:layout_gravity="center"
                    android:layout_marginBottom="40dp" />

                <!-- User Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUser"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="User"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:letterSpacing="0.0"
                    app:backgroundTint="@color/primary"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="0dp"
                    android:layout_marginBottom="20dp" />

                <!-- Admin Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Admin"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:letterSpacing="0.0"
                    app:backgroundTint="@color/background"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="160dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Elevated App ID Footer -->
    <include
        android:id="@+id/app_id_footer"
        layout="@layout/layout_scan_app_id_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
