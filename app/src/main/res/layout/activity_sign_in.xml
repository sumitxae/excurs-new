<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="400dp"
            android:layout_gravity="center">

            <!-- Logo Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:layout_gravity="start">

                <ImageView
                    android:id="@+id/ivChorusLogo"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_chorus_logo"
                    android:layout_marginTop="50dp"
                    android:layout_marginBottom="210dp"
                    android:scaleType="fitCenter" />

            </LinearLayout>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Let's"
                android:textSize="42sp"
                android:textColor="#000000"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:layout_gravity="start"
                android:layout_marginBottom="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get Started!"
                android:textSize="42sp"
                android:textColor="#000000"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:layout_gravity="start"
                android:layout_marginBottom="5dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please enter a valid email."
                android:textSize="15sp"
                android:textColor="#000000"
                android:fontFamily="sans-serif"
                android:alpha="0.5"
                android:layout_gravity="start"
                android:layout_marginTop="1dp"
                android:layout_marginLeft="2dp"
                android:layout_marginBottom="10dp" />

            <!-- Email Input Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="textEmailAddress"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:background="#F9F9F9"
                    android:hint="Email address"
                    android:textColorHint="#C7C7CD"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="10dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:gravity="center_vertical"
                    android:textCursorDrawable="@color/primary" />

            </LinearLayout>

            <!-- Password Input Container (initially hidden) -->
            <LinearLayout
                android:id="@+id/llPasswordContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="10dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="textPassword"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:background="#F9F9F9"
                        android:hint="Password"
                        android:textColorHint="#C7C7CD"
                        android:fontFamily="sans-serif"
                        android:paddingHorizontal="10dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="50dp"
                        android:gravity="center_vertical"
                        android:textCursorDrawable="@color/primary" />

                    <ImageView
                        android:id="@+id/ivPasswordToggle"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_visibility_off"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="10dp" />

                </FrameLayout>

            </LinearLayout>

            <!-- Options Container (Remember Me & Forgot Password) -->
            <LinearLayout
                android:id="@+id/llOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start|center_vertical"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="30dp"
                android:visibility="gone">

                <!-- Remember Me Container -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="-5dp">

                    <CheckBox
                        android:id="@+id/cbRememberMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary"
                        android:background="@null"
                        android:padding="0dp"
                        android:layout_margin="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remember Me"
                        android:textSize="15sp"
                        android:textColor="#000000"
                        android:fontFamily="sans-serif"
                        android:alpha="0.6"
                        android:layout_marginLeft="-2dp" />

                </LinearLayout>

                <!-- Forgot Password -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password?"
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:fontFamily="sans-serif"
                    android:alpha="0.6"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Sign In Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Next"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                app:cornerRadius="5dp"
                app:backgroundTint="#EF652B"
                app:strokeColor="#EF652B"
                app:strokeWidth="0dp"
                android:layout_marginBottom="160dp" />

            <!-- Contact Us Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="-140dp"
                android:layout_marginBottom="140dp">

                <TextView
                    android:id="@+id/tvContactUs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Us"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:fontFamily="sans-serif"
                    android:alpha="0.5"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:textStyle="normal" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView> 