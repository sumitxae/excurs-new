<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@color/background"
    android:gravity="center">

    <!-- Icon -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_md"
        android:src="@drawable/bluetooth_disabled_24px"
        android:contentDescription="Bluetooth Disabled Icon"
        android:tint="@color/error" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:text="Bluetooth is Turned Off"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:text="Please turn on your Bluetooth to continue using the app."
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingExtra="2dp" />

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Cancel Button (Secondary Style) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="Cancel"
            android:textSize="16sp"
            android:letterSpacing="0.0"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            app:cornerRadius="5dp"
            app:backgroundTint="@color/background"
            app:strokeColor="@color/text_primary"
            app:strokeWidth="1.5dp"
            android:minWidth="100dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- Settings Button (Primary Style) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Open Settings"
            android:textSize="16sp"
            android:textColor="@color/background"
            android:textStyle="bold"
            android:letterSpacing="0.0"
            app:cornerRadius="5dp"
            app:backgroundTint="@color/primary"
            app:strokeColor="@color/primary"
            app:strokeWidth="0dp"
            android:minWidth="140dp" />

    </LinearLayout>

</LinearLayout> 